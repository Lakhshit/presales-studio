{
  "version": "2026.11-default",
  "ROLES": [
    {
      "code": "PM",
      "name": "Project Manager",
      "rate": 900
    },
    {
      "code": "SA",
      "name": "Solution Architect",
      "rate": 1100
    },
    {
      "code": "SC",
      "name": "Senior Consultant",
      "rate": 850
    },
    {
      "code": "C",
      "name": "Consultant",
      "rate": 600
    },
    {
      "code": "QA",
      "name": "Test Lead / Analyst",
      "rate": 550
    }
  ],
  "PHASES": [
    "1. Initiate",
    "2. Discover & Assess",
    "3. Design",
    "4. Build / Migrate",
    "5. Test",
    "6. Deploy & Cutover",
    "7. Hypercare & Close",
    "8. Project Management"
  ],
  "DOMAINS": {
    "COMMON": {
      "code": "COMMON",
      "name": "Common / Governance",
      "always": true
    },
    "MW": {
      "code": "MW",
      "name": "Middleware (WebLogic / SOA / OSB / OHS)"
    },
    "OCI": {
      "code": "OCI",
      "name": "OCI Infrastructure (Landing Zone / Lift & Shift)"
    },
    "DB": {
      "code": "DB",
      "name": "Oracle Database (Upgrade / Migration)"
    }
  },
  "DRIVERS": [
    {
      "key": "hypercare_weeks",
      "domain": "COMMON",
      "label": "Hypercare period",
      "unit": "weeks",
      "type": "number",
      "def": 2,
      "q": "What post go-live hypercare / warranty period is expected (in weeks)?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s*(?:-|\\s)?\\s*weeks?\\s+(?:of\\s+)?(?:hypercare|warranty|post[- ]go[- ]live support)"
        },
        {
          "__rx": "(?:hypercare|warranty)[^.\\n]{0,40}?(\\d+)\\s*weeks?"
        }
      ]
    },
    {
      "key": "perf_testing",
      "domain": "COMMON",
      "label": "Performance testing in scope",
      "unit": "yes=1 / no=0",
      "type": "flag",
      "def": 0,
      "q": "Is performance / load testing in scope for the vendor, and who provides the tooling and scripts?",
      "patterns": [
        {
          "__rx": "(performance|load|stress)\\s+test"
        }
      ]
    },
    {
      "key": "mw_envs",
      "domain": "MW",
      "label": "Environments (Dev/SIT/UAT/Prod…)",
      "unit": "count",
      "type": "number",
      "def": 4,
      "q": "How many environments are in scope for the middleware work (e.g. DEV, SIT, UAT, PROD, DR)?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:[\\w-]+\\s+)?environments\\b"
        }
      ]
    },
    {
      "key": "mw_domains",
      "domain": "MW",
      "label": "WebLogic domains (total across envs)",
      "unit": "count",
      "type": "number",
      "def": 4,
      "q": "How many WebLogic domains exist in total across all environments?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:weblogic\\s+|wls\\s+)?domains?"
        }
      ]
    },
    {
      "key": "mw_servers",
      "domain": "MW",
      "label": "Managed servers (total)",
      "unit": "count",
      "type": "number",
      "def": 16,
      "q": "How many managed servers (and clusters) are configured in total?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+managed\\s+servers?"
        },
        {
          "__rx": "(\\d+)\\s+(?:weblogic|wls)\\s+servers?"
        }
      ]
    },
    {
      "key": "mw_apps",
      "domain": "MW",
      "label": "Deployed applications (distinct)",
      "unit": "count",
      "type": "number",
      "def": 10,
      "q": "How many distinct applications (EAR/WAR) are deployed, and how many contain custom code?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:(?:custom|java|j2ee|jee|deployed|business|web|in-house)\\s+){0,2}(?:applications|apps|ears?|wars?)\\b"
        }
      ]
    },
    {
      "key": "mw_soa",
      "domain": "MW",
      "label": "SOA composites",
      "unit": "count",
      "type": "number",
      "def": 0,
      "q": "How many SOA Suite composites (BPEL/Mediator) are deployed?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:soa\\s+)?composites?"
        },
        {
          "__rx": "(\\d+)\\s+bpel\\s+process"
        }
      ]
    },
    {
      "key": "mw_osb",
      "domain": "MW",
      "label": "OSB services (proxy + business)",
      "unit": "count",
      "type": "number",
      "def": 0,
      "q": "How many OSB proxy and business services are deployed?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:osb\\s+)?(?:proxy|business)\\s+services?"
        },
        {
          "__rx": "(\\d+)\\s+osb\\s+services?"
        }
      ]
    },
    {
      "key": "mw_ohs",
      "domain": "MW",
      "label": "OHS / web-tier instances",
      "unit": "count",
      "type": "number",
      "def": 0,
      "q": "How many Oracle HTTP Server (web tier) instances are in scope?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:ohs|oracle http server|web\\s*tier)\\s+(?:instances?|nodes?|servers?)"
        }
      ]
    },
    {
      "key": "oci_envs",
      "domain": "OCI",
      "label": "Environments",
      "unit": "count",
      "type": "number",
      "def": 3,
      "q": "How many environments must be built on OCI (e.g. DEV, TEST, PROD)?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:[\\w-]+\\s+)?environments\\b"
        }
      ]
    },
    {
      "key": "oci_vms",
      "domain": "OCI",
      "label": "Servers / VMs to migrate",
      "unit": "count",
      "type": "number",
      "def": 20,
      "q": "How many servers / VMs are to be migrated, and what is the split by OS?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:virtual machines|vms?|servers|compute instances|hosts)\\b"
        }
      ]
    },
    {
      "key": "oci_os",
      "domain": "OCI",
      "label": "Distinct OS variants",
      "unit": "count",
      "type": "number",
      "def": 2,
      "q": "Which operating systems and versions are in use (e.g. OL8, RHEL 7, Windows 2019)?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:different\\s+)?(?:operating systems|os (?:types|variants|flavours|flavors))"
        }
      ]
    },
    {
      "key": "oci_vcn",
      "domain": "OCI",
      "label": "VCNs / network segments",
      "unit": "count",
      "type": "number",
      "def": 2,
      "q": "How many VCNs / network segments are required, and is connectivity via FastConnect or IPSec VPN?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:vcns?|virtual cloud networks?|network segments|subnets)"
        }
      ]
    },
    {
      "key": "oci_storage",
      "domain": "OCI",
      "label": "Storage to migrate",
      "unit": "TB",
      "type": "number",
      "def": 5,
      "q": "What is the total volume of data / storage to be migrated (TB)?",
      "patterns": [
        {
          "__rx": "(\\d+(?:\\.\\d+)?)\\s*tb\\b"
        }
      ]
    },
    {
      "key": "oci_lz",
      "domain": "OCI",
      "label": "Landing zone build required",
      "unit": "yes=1 / no=0",
      "type": "flag",
      "def": 1,
      "q": "Does a new OCI landing zone (tenancy, compartments, IAM, logging) need to be built?",
      "patterns": [
        {
          "__rx": "landing\\s+zone"
        }
      ]
    },
    {
      "key": "oci_sec",
      "domain": "OCI",
      "label": "Security services to configure",
      "unit": "count",
      "type": "number",
      "def": 3,
      "q": "Which security services are required (WAF, Vault/KMS, Cloud Guard, Bastion, Security Zones)?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+security\\s+services?"
        }
      ]
    },
    {
      "key": "oci_dr",
      "domain": "OCI",
      "label": "DR region setup required",
      "unit": "yes=1 / no=0",
      "type": "flag",
      "def": 0,
      "q": "Is a disaster-recovery setup in a second region required? What RPO / RTO?",
      "patterns": [
        {
          "__rx": "disaster\\s+recovery|\\bdr\\s+(?:site|region|setup)|\\brpo\\b|\\brto\\b"
        }
      ]
    },
    {
      "key": "oci_mon",
      "domain": "OCI",
      "label": "Monitoring & logging setup",
      "unit": "yes=1 / no=0",
      "type": "flag",
      "def": 1,
      "q": "Is monitoring, alerting and log aggregation setup in scope?",
      "patterns": [
        {
          "__rx": "monitoring|alerting|observability"
        }
      ]
    },
    {
      "key": "db_count",
      "domain": "DB",
      "label": "Databases in scope",
      "unit": "count",
      "type": "number",
      "def": 5,
      "q": "How many databases are in scope (by environment), and what are their versions?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:oracle\\s+)?databases?"
        },
        {
          "__rx": "(\\d+)\\s+(?:dbs|db instances|pdbs)\\b"
        }
      ]
    },
    {
      "key": "db_size",
      "domain": "DB",
      "label": "Total database size",
      "unit": "TB",
      "type": "number",
      "def": 2,
      "q": "What is the total database size to migrate (TB) and the daily change rate?",
      "patterns": [
        {
          "__rx": "(\\d+(?:\\.\\d+)?)\\s*tb\\b"
        }
      ]
    },
    {
      "key": "db_envs",
      "domain": "DB",
      "label": "Target environments",
      "unit": "count",
      "type": "number",
      "def": 3,
      "q": "How many target database environments must be provisioned?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:[\\w-]+\\s+)?environments\\b"
        }
      ]
    },
    {
      "key": "db_zdt",
      "domain": "DB",
      "label": "DBs needing near-zero downtime (GoldenGate/ZDM)",
      "unit": "count",
      "type": "number",
      "def": 0,
      "q": "Which databases require near-zero downtime migration (GoldenGate / ZDM online)? What outage window is acceptable?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+[^.\\n]{0,30}(?:zero|minimal|near[- ]zero)\\s+downtime"
        }
      ]
    },
    {
      "key": "db_rac",
      "domain": "DB",
      "label": "RAC databases",
      "unit": "count",
      "type": "number",
      "def": 0,
      "q": "How many databases run on (or must move to) RAC?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+rac\\b"
        },
        {
          "__rx": "(\\d+)\\s+[^.\\n]{0,20}real application clusters"
        }
      ]
    },
    {
      "key": "db_dg",
      "domain": "DB",
      "label": "Data Guard standby setups",
      "unit": "count",
      "type": "number",
      "def": 0,
      "q": "How many databases need Data Guard standby configuration?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+[^.\\n]{0,20}data\\s*guard"
        }
      ]
    },
    {
      "key": "db_apps",
      "domain": "DB",
      "label": "Connected applications to re-test",
      "unit": "count",
      "type": "number",
      "def": 5,
      "q": "How many applications connect to these databases and need connectivity / regression testing?",
      "patterns": [
        {
          "__rx": "(\\d+)\\s+(?:connected|dependent|consuming)\\s+applications?"
        }
      ]
    }
  ],
